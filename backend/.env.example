# --- Groq (server-side only, NEVER exposed to the frontend) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Firebase Admin (for verifying user ID tokens on protected routes) ---
# Paste the full JSON of your Firebase service account key on one line,
# or point to a file path instead (see services/firebaseAdmin.js).
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Server ---
PORT=8080
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Rate limiting ---
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20
